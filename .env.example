# Neon connection string for the `development` branch (pooled).
DATABASE_URL=

# GitHub OAuth app (Settings → Developer settings → OAuth Apps).
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord OAuth app (discord.com/developers/applications → OAuth2).
# Redirect: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Better Auth: generate the secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The TOLC Discord server's ID (Discord developer mode → right-click the
# server → Copy Server ID). Only its Members get past sign-in.
TOLC_DISCORD_GUILD_ID=

# The Admin's Discord user ID (Discord developer mode → right-click your
# name → Copy User ID). Only that Member can merge Catalog entries.
ADMIN_DISCORD_USER_ID=
